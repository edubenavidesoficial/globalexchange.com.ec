idget-container\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix\">\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3a34f0d elementor-widget elementor-widget-heading\" data-id=\"3a34f0d\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Programas Escolaridad Global Exchange<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2497d10 elementor-widget elementor-widget-spacer\" data-id=\"2497d10\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-da52ed1 elementor-widget elementor-widget-text-editor\" data-id=\"da52ed1\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix\">\n\t\t\t\t<p>La oportunidad de sumergirte en la cultura y el idioma del pa\u00eds de destino est\u00e1 en tus manos, en este proceso nuestro (a) estudiante vivir\u00e1 en el pa\u00eds del exterior durante: un trimestre o a\u00f1o escolar.<br \/>Cursos 1ero, 2do y 3ero de bachillerato en el exterior.<\/p>\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0428cca elementor-widget elementor-widget-spacer\" data-id=\"0428cca\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-10731c6 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"10731c6\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t\t\t<div class=\"elementor-row\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-39ca3e8\" data-id=\"39ca3e8\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-column-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t<div class=\"elementor-widget-wrap\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-9e0b75e elementor-position-top elementor-vertical-align-top elementor-widget elementor-widget-gt3-core-imagebox\" data-id=\"9e0b75e\" data-element_type=\"widget\" data-widget_type=\"gt3-core-imagebox.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"gt3-core-imagebox-wrapper elementor-image_icon-position-default\"><figure class=\"gt3-core-imagebox-img gt3-core-imagebox-img_hover\"><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"mortarboard\" \/><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/mortarboard-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"mortarboard\" \/><\/figure><div class=\"gt3-core-imagebox-content\"><div class=\"gt3-core-imagebox-title\"><h5 class=\"gt3-core-imagebox-title\">ESCOLARIDAD EN COLEGIO P\u00daBLICO<\/h5><\/div><p class=\"gt3-core-imagebox-description\">Tu familia del exterior se convertir\u00e1 en tu segundo hogar compartiendo la vida en todas sus dimensiones.\nUn dormitorio simple o doble, estar\u00e1 disponible para tu comodidad; dependiendo de la temporada, podr\u00e1s compartir tu experiencia con otro estudiante de cualquier parte del mundo.\nLa familia se encargar\u00e1 de tu alojamiento y\nalimentaci\u00f3n y apoyo.\nMejora el idioma en el pa\u00eds que te encuentres.\nAsistir\u00e1s a los m\u00e1s prestigiosos colegios p\u00fablicos del mundo\nOficina de apoyo-coordinador de \u00e1rea responsable 24\/7.<\/p><\/div><\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-df210fe\" data-id=\"df210fe\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-column-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t<div class=\"elementor-widget-wrap\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-92598f9 elementor-position-top elementor-vertical-align-top elementor-widget elementor-widget-gt3-core-imagebox\" data-id=\"92598f9\" data-element_type=\"widget\" data-widget_type=\"gt3-core-imagebox.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"gt3-core-imagebox-wrapper elementor-image_icon-position-default\"><figure class=\"gt3-core-imagebox-img gt3-core-imagebox-img_hover\"><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"reading\" \/><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/reading-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"reading\" \/><\/figure><div class=\"gt3-core-imagebox-content\"><div class=\"gt3-core-imagebox-title\"><h5 class=\"gt3-core-imagebox-title\">ALOJAMIENTO EN RESIDENCIA ESTUDIANTIL<\/h5><\/div><p class=\"gt3-core-imagebox-description\">Normalmente este tipo de alojamiento se ofrece en colegios privados dentro de su establecimiento con zonas para chicos y chicas, con todos los est\u00e1ndares de calidad y servicio de catering en su alimentaci\u00f3n y cuidado 24\/7 para nuestros estudiantes.\nRegularmente, los fines de semanas las familias de acogidas esperan por nuestros estudiantes con el fin de compartir actividades de paseos, almuerzos y viajes, y lograr as\u00ed una estad\u00eda muy placentera, c\u00f3moda y de crecimiento personal.<\/p><\/div><\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-494098d cloud_animated_bottom elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"494098d\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t\t\t<div class=\"elementor-row\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-b04ccfa\" data-id=\"b04ccfa\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-column-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t<div class=\"elementor-widget-wrap\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3757679 elementor-widget elementor-widget-spacer\" data-id=\"3757679\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-36d4b54 elementor-position-top elementor-vertical-align-top elementor-widget elementor-widget-gt3-core-imagebox\" data-id=\"36d4b54\" data-element_type=\"widget\" data-widget_type=\"gt3-core-imagebox.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"gt3-core-imagebox-wrapper elementor-image_icon-position-default\"><figure class=\"gt3-core-imagebox-img\"><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/read-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"read\" \/><\/figure><div class=\"gt3-core-imagebox-content\"><div class=\"gt3-core-imagebox-title\"><h5 class=\"gt3-core-imagebox-title\">VALORES AGREGADOS DEL PROGRAMA ESCOLARIDAD<\/h5><\/div><p class=\"gt3-core-imagebox-description\">Aprendizaje y dominio del idioma del pa\u00eds de\ndestino dejando la oportunidad al estudiante para rendir su examen de suficiencia idiom\u00e1tica.\nIntercambio cultural y aprendizaje profundo de\ncostumbres, criterio m\u00e1s amplio para elecci\u00f3n de carrera profesional y visitas a paisajes fascinantes<\/p><\/div><\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-194028b\" data-id=\"194028b\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-column-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t<div class=\"elementor-widget-wrap\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-07acd05 elementor-widget elementor-widget-spacer\" data-id=\"07acd05\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-949f330 elementor-position-top elementor-vertical-align-top elementor-widget elementor-widget-gt3-core-imagebox\" data-id=\"949f330\" data-element_type=\"widget\" data-widget_type=\"gt3-core-imagebox.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"gt3-core-imagebox-wrapper elementor-image_icon-position-default\"><figure class=\"gt3-core-imagebox-img gt3-core-imagebox-img_hover\"><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"sport\" \/><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/sport-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"sport\" \/><\/figure><div class=\"gt3-core-imagebox-content\"><div class=\"gt3-core-imagebox-title\"><h5 class=\"gt3-core-imagebox-title\">ACTIVIDADES EXTRACURRICULARES<\/h5><\/div><p class=\"gt3-core-imagebox-description\">Clubs y Actividades: Los estudiantes tienen una amplia gama de oportunidades al momento de elegir actividades extracurriculares para las tardes luego de clases. Entre los deportes que pueden elegir est\u00e1n el F\u00fatbol, Basquetbol, Voleibol, Nataci\u00f3n, entre otros y clubs de periodismo, m\u00fasica, teatro, canto, dibujo y literatura.\nLas escuelas normalmente ofrecen excursiones y eventos especiales en los d\u00edas festivos como navidad, spring-break, graduaci\u00f3n, entre otros.<\/p><\/div><\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d50719a elementor-widget elementor-widget-spacer\" data-id=\"d50719a\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5a6fee4 elementor-position-top elementor-vertical-align-top elementor-widget elementor-widget-gt3-core-imagebox\" data-id=\"5a6fee4\" data-element_type=\"widget\" data-widget_type=\"gt3-core-imagebox.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"gt3-core-imagebox-wrapper elementor-image_icon-position-default\"><figure class=\"gt3-core-imagebox-img gt3-core-imagebox-img_hover\"><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"house (1)\" \/><img width=\"512\" height=\"512\" src=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1.png\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1.png 512w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-300x300.png 300w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-150x150.png 150w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-480x480.png 480w, https:\/\/globalexchange.com.ec\/wp-content\/uploads\/2021\/09\/house-1-400x400.png 400w\" sizes=\"(max-width: 512px) 100vw, 512px\" title=\"house (1)\" \/><\/figure><div class=\"gt3-core-imagebox-content\"><div class=\"gt3-core-imagebox-title\"><h5 class=\"gt3-core-imagebox-title\">Cambio de Familia Anfitriona<\/h5><\/div><p class=\"gt3-core-imagebox-description\">En nuestros programas tienes la posibilidad de cambiar hasta 3 veces de familia anfitriona en caso de ser necesario.\nAPOYO 24\/7 tutor para nuestros estudiantes, pendiente de ellos en todo momento<\/p><\/div><\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-512ffe9 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"512ffe9\" data-element_type=\"section\">\n\t\t\t\t\